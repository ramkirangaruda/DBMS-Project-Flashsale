# Copy to .env for local overrides (app/database.py, app/main.py etc. all
# read these via os.getenv with the same defaults shown here -- .env itself
# is gitignored and NOT loaded automatically by this project; export these
# into your shell, or use `env $(cat .env | xargs) ...`, or your own
# process manager's env-file support). None of this is required for
# docker-compose -- see the README's "Setup" section for the zero-config
# path.

# ---- Local / docker-compose (all optional -- these ARE the defaults) ----
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5435
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=flashsale
# REDIS_HOST=localhost
# REDIS_PORT=6390

# ---- Vercel / managed services (see README: "Deploying to Vercel") ----
# DATABASE_URL wins outright over POSTGRES_* above when set.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# REDIS_URL wins outright over REDIS_HOST/REDIS_PORT above when set.
# Upstash gives you a rediss://... URL (TLS) -- use that one, not its REST URL.
# REDIS_URL=rediss://default:token@host:6379

# No Jaeger collector on Vercel -- required there, harmless locally.
# OTEL_SDK_DISABLED=true

# Required before exposing POST /admin/reset-sale beyond a trusted network.
# ADMIN_TOKEN=

# Comma-separated allowlist instead of the "*" default -- see app/main.py's
# note on why "*" is fine for this project's unauthenticated demo data.
# CORS_ORIGINS=https://your-deployment.vercel.app

# Admission-worker tuning (app/queue.py) -- defaults shown.
# QUEUE_ADMIT_BATCH=10
# QUEUE_ADMIT_INTERVAL=0.5
# QUEUE_ADMISSION_TTL=30
# ADMISSION_ENFORCED=true
